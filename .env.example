# ================================
# JARVIS - Variables d'environnement
# ================================
# Copiez ce fichier : cp .env.example .env
# Ne JAMAIS commiter .env sur GitHub

# --- LLM Local (Ollama) ---
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=mistral:latest
# Taille du contexte en tokens (plus grand = plus de mémoire vive)
OLLAMA_NUM_CTX=4096

# --- LLM Cloud (optionnel) ---
ANTHROPIC_API_KEY=

# --- Utilisateur ---
JARVIS_USER_NAME=
JARVIS_LANGUAGE=fr
# Lire les réponses à voix haute : on / off
JARVIS_VOICE=on

# --- Environnement local ---
# Dossier où Jarvis peut lire / écrire des fichiers (défaut : dossier personnel)
# JARVIS_WORKSPACE=/srv
# Autoriser Jarvis à lancer des commandes (toujours avec confirmation) : on / off
JARVIS_ALLOW_COMMANDS=on
JARVIS_COMMAND_TIMEOUT=30

# --- Mode serveur (python start.py --server) ---
# Clé d'accès OBLIGATOIRE (page web + API). Générez-en une :
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
JARVIS_API_KEY=
# 127.0.0.1 : seulement depuis le serveur (exposé par un tunnel HTTPS)
JARVIS_HOST=127.0.0.1
JARVIS_PORT=8765
# Interfaces web autorisées à appeler l'API depuis le navigateur (CORS),
# séparées par des virgules. Inutile si l'interface passe par son propre backend (Nexus).
# JARVIS_CORS_ORIGINS=https://jarvis-app.mondomaine.com
# Secondes pour accepter / refuser une action sensible
JARVIS_CONFIRM_TIMEOUT=120

# --- Application hôte (ex. Nexus) : ses actions deviennent des outils de Jarvis ---
# JARVIS_HOST_TOOLS_URL=http://127.0.0.1:3001/api/jarvis/tools
# Même valeur que JARVIS_TOOLS_SECRET dans le .env de Nexus (openssl rand -base64 32)
# JARVIS_HOST_SECRET=

# --- Notifications push (téléphone) ---
# Contact transmis à Apple / Google / Mozilla avec chaque notification
JARVIS_PUSH_CONTACT=mailto:jarvis@example.com

# --- Données ---
# Dossier de la mémoire, des tâches, rappels et notes (défaut : ./data)
# JARVIS_DATA_DIR=
