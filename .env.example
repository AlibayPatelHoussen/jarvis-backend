# ================================
# JARVIS - Variables d'environnement
# ================================
# Copiez ce fichier : cp .env.example .env
# Ne JAMAIS commiter .env sur GitHub

# --- LLM Local (Ollama) ---
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=mistral:latest

# --- LLM Cloud (optionnel) ---
ANTHROPIC_API_KEY=

# --- Utilisateur ---
JARVIS_USER_NAME=
JARVIS_LANGUAGE=fr
